---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import photo from '../assets/me.jpg';
import { SITE, asset } from '../consts';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="section bg-surface" aria-labelledby="about-title">
  <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-4">
      <div class="photo" data-reveal="group">
        <div class="frame"></div>
        <Image
          src={photo}
          alt={t('about.photoAlt')}
          width={800}
          widths={[400, 800]}
          sizes="(min-width: 1024px) 380px, 85vw"
        />
      </div>
    </div>

    <div class="lg:col-span-7 lg:col-start-6">
      <h2 id="about-title" class="sr-only">{t('about.title')}</h2>
      <p class="font-serif text-[clamp(1.35rem,1rem+1.4vw,1.85rem)] leading-snug italic text-heading" data-reveal>
        {t('about.lead')}
      </p>
      <p class="mt-6 max-w-[58ch] text-[0.9375rem]" data-reveal style="--i: 1">{t('about.body')}</p>
      <div class="mt-8 flex flex-wrap gap-3" data-reveal style="--i: 2">
        <a href="#projects" class="btn">{t('about.cta')}</a>
        <a href={asset(SITE.cv[lang])} class="btn btn-outline" download>
          <Icon name="bi:download" />
          {t('about.cv')}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .photo {
    --frame: 20px;
    --dx: 40px;
    --dy: 60px;
    position: relative;
    height: 410px;
    margin-top: var(--dy);
  }

  .frame {
    position: absolute;
    inset: 0;
    border: var(--frame) solid var(--color-mint);
  }

  .photo img {
    position: absolute;
    top: calc(var(--frame) - var(--dy));
    left: calc(var(--frame) + var(--dx));
    width: calc(100% - 2 * var(--frame));
    height: calc(100% - 10px);
    object-fit: cover;
    box-shadow: 0 0 85px rgb(0 0 0 / 0.14);
  }

  .frame {
    transition: clip-path 1s var(--ease-out-soft);
  }

  .photo img {
    transition:
      opacity 0.8s ease 0.35s,
      translate 0.9s var(--ease-out-soft) 0.35s;
  }

  :global(.js) .photo:not(:global(.is-visible)) .frame {
    clip-path: inset(0 100% 0 0);
  }

  :global(.js) .photo:not(:global(.is-visible)) img {
    opacity: 0;
    translate: 0 1.75rem;
  }

  @media (max-width: 1023px) {
    .photo {
      --frame: 14px;
      --dx: 24px;
      --dy: 36px;
      max-width: 22rem;
      height: 380px;
      margin-right: var(--dx);
    }
  }
</style>
