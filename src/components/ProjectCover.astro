---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Locale, type UIKey } from '../i18n/ui';

interface Props {
  lang: Locale;
  project: CollectionEntry<'projects'>['data'];
  /** `sizes` attribute for the screenshot. */
  sizes: string;
  /** Load eagerly when the cover is above the fold. */
  eager?: boolean;
}

const { lang, project, sizes, eager = false } = Astro.props;
const t = useTranslations(lang);
---

{
  project.cover ? (
    <Image
      src={project.cover}
      alt=""
      class="cover"
      widths={[480, 800, 1200]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
    />
  ) : (
    // No screenshot yet: a typographic cover built from the project data.
    <div class="cover generated" aria-hidden="true">
      <span class="label">{t(`category.${project.category}` as UIKey)}</span>
      <span class="name">{project.title}</span>
      <span class="stack">{project.stack.slice(0, 3).join(' · ')}</span>
    </div>
  )
}

<style>
  .cover {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .generated {
    container-type: inline-size;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.1rem, 7%, 2.5rem);
    color: #f2f2f2;
    background:
      linear-gradient(rgb(145 224 196 / 0.07) 1px, transparent 1px) 0 0 / 100% 2rem,
      linear-gradient(90deg, rgb(145 224 196 / 0.07) 1px, transparent 1px) 0 0 / 2rem 100%,
      linear-gradient(135deg, #303839, #1f2526);
  }

  .generated::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    width: 28%;
    height: 6px;
    background: #91e0c4;
  }

  .label,
  .stack {
    font-size: clamp(0.625rem, 2.6cqw, 0.8125rem);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .label {
    color: #91e0c4;
  }

  .stack {
    color: rgb(242 242 242 / 0.7);
  }

  .name {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.4rem, 8.5cqw, 3.5rem);
    line-height: 1.12;
    text-wrap: balance;
  }
</style>
