---
import { Icon } from 'astro-icon/components';
import { skills, useTranslations, type Locale, type UIKey } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="skills" class="section bg-surface pt-0!" aria-labelledby="skills-title">
  <div class="wrap">
    <h2 id="skills-title" class="section-title" data-reveal>{t('skills.title')}</h2>
    <ul class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        skills.map((group, index) => (
          <li data-reveal style={`--i: ${index}`}>
            <Icon name={group.icon} class="text-[2.75rem] text-mint-strong" />
            <h3 class="mt-4 text-[0.8125rem] font-medium uppercase tracking-[0.1em]">
              {t(`skills.${group.key}` as UIKey)}
            </h3>
            <p class="mt-2 text-[0.8125rem] leading-[1.7]">{t(`skills.${group.key}.text` as UIKey)}</p>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <li class="chip">{item}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
