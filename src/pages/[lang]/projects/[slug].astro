---
import { render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Icon } from 'astro-icon/components';
import Base from '../../../layouts/Base.astro';
import ProjectCover from '../../../components/ProjectCover.astro';
import { SITE } from '../../../consts';
import { formatDate, getProjects, type Project } from '../../../lib/projects';
import { locales, useTranslations, type Locale, type UIKey } from '../../../i18n/ui';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of locales) {
    const projects = await getProjects(lang);
    for (const [index, project] of projects.entries()) {
      paths.push({
        params: { lang, slug: project.slug },
        props: { project, next: projects[(index + 1) % projects.length] },
      });
    }
  }
  return paths;
}

interface Props {
  project: Project;
  next: Project;
}

const lang = Astro.params.lang as Locale;
const { project, next } = Astro.props;
const { slug, entry } = project;
const { data } = entry;
const t = useTranslations(lang);
const { Content } = await render(entry);
---

<Base
  lang={lang}
  title={`${data.title} — ${SITE.name}`}
  description={data.summary}
  path={`projects/${slug}/`}
>
  <article class="wrap pb-20 pt-28 lg:pt-32">
    <a href={`${getRelativeLocaleUrl(lang)}#projects`} class="back animate-in" style="--i: 0">
      <Icon name="bi:arrow-left" />
      {t('projects.back')}
    </a>

    <header class="mt-6 max-w-3xl">
      <p class="animate-in text-xs font-medium uppercase tracking-[0.16em] text-accent" style="--i: 0">
        {t(`category.${data.category}` as UIKey)}
      </p>
      <h1 class="animate-in mt-2 text-[clamp(1.9rem,1.3rem+2.6vw,3rem)] font-bold" style="--i: 1">{data.title}</h1>
      <p class="animate-in mt-4 font-serif text-[clamp(1.15rem,1rem+0.7vw,1.45rem)] leading-snug italic text-heading" style="--i: 2">
        {data.summary}
      </p>
    </header>

    <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-8">
        <figure class="aspect-[16/10] overflow-hidden" transition:name={`project-${slug}`}>
          <ProjectCover lang={lang} project={data} sizes="(min-width: 1024px) 740px, 92vw" eager />
        </figure>
        <div class="prose animate-in mt-10 max-w-[65ch]" style="--i: 3">
          <Content />
        </div>
      </div>

      <aside class="lg:col-span-4">
        <div class="panel animate-in" style="--i: 3">
          <h2>{t('projects.info')}</h2>
          <dl>
            <div>
              <dt>{t('projects.category')}</dt>
              <dd>{t(`category.${data.category}` as UIKey)}</dd>
            </div>
            <div>
              <dt>{t('projects.date')}</dt>
              <dd><time datetime={data.date.toISOString().slice(0, 10)}>{formatDate(data.date, lang)}</time></dd>
            </div>
            <div>
              <dt>{t('projects.stack')}</dt>
              <dd>
                <ul class="mt-1 flex flex-wrap gap-1.5">
                  {data.stack.map((item) => <li class="chip">{item}</li>)}
                </ul>
              </dd>
            </div>
          </dl>
          {
            (data.repo || data.demo) && (
              <div class="mt-6 flex flex-wrap gap-3">
                {data.demo && (
                  <a href={data.demo} class="btn" target="_blank" rel="noopener noreferrer">
                    <Icon name="bi:box-arrow-up-right" />
                    {t('projects.demo')}
                  </a>
                )}
                {data.repo && (
                  <a
                    href={data.repo}
                    class:list={['btn', { 'btn-outline': data.demo }]}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Icon name="bi:github" />
                    {t('projects.repo')}
                  </a>
                )}
              </div>
            )
          }
        </div>
      </aside>
    </div>

    {
      next.slug !== slug && (
        <a href={getRelativeLocaleUrl(lang, `projects/${next.slug}/`)} class="next">
          <span class="label">{t('projects.next')}</span>
          <span class="title">
            {next.entry.data.title}
            <Icon name="bi:arrow-right" />
          </span>
        </a>
      )
    }
  </article>
</Base>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.3s ease;
  }

  .back:hover {
    color: var(--accent-text);
  }

  .back :global(svg) {
    transition: translate 0.3s var(--ease-out-soft);
  }

  .back:hover :global(svg) {
    translate: -4px 0;
  }

  .panel {
    padding: 1.875rem;
    background: var(--card);
    box-shadow: 0 0 30px rgb(var(--shadow) / 0.08);
  }

  .panel h2 {
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--line);
    font-size: 1.125rem;
    font-weight: 700;
  }

  dl > div {
    margin-top: 1.1rem;
  }

  dt {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  dd {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--heading);
  }

  .next {
    display: block;
    margin-top: 4.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .next .label {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .next .title {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.35rem;
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.75rem);
    font-weight: 600;
    color: var(--heading);
    transition: color 0.3s ease;
  }

  .next .title :global(svg) {
    transition: translate 0.3s var(--ease-out-soft);
  }

  .next:hover .title {
    color: var(--accent-text);
  }

  .next:hover .title :global(svg) {
    translate: 6px 0;
  }
</style>
